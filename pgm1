int sensorPin = A0;
int sensorValue = 0;

void setup() {
  Serial.begin(9600);
}

void loop() {
  sensorValue = analogRead(sensorPin);

  Serial.print("Turbidity Sensor Value: ");
  Serial.println(sensorValue);

  if (sensorValue < 300) {
    Serial.println("Water is relatively clear");
  }
  else if (sensorValue < 600) {
    Serial.println("Water is moderately cloudy");
  }
  else {
    Serial.println("Water is very cloudy");
  }

  Serial.println("--------------------");

  delay(2000);
}
Important
The exact sensor readings and cutoff values depend on the particular turbidity sensor and its calibration. For a school demonstration, use the readings mainly to compare the same water before and after filtration, rather than treating the numbers as a drinking-water safety measurement.
